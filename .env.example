# Deriv OAuth & App Configuration
CLIENT_ID=your-oauth-client-id-here
APP_ID=your-deriv-app-id-here
# OAuth Redirect URI - can also use DERIV_REDIRECT_URI, DERIV_OAUTH_REDIRECT_URI, or REDIRECT_URI
OAUTH_REDIRECT_URI=https://your-domain.com/callback

# Optional Google Drive Configuration
GD_CLIENT_ID=your-google-drive-client-id-here
GD_APP_ID=your-google-drive-app-id-here
GD_API_KEY=your-google-drive-api-key-here

# Optional Third-Party Services
TRANSLATIONS_CDN_URL=
R2_PROJECT_NAME=
CROWDIN_BRANCH_NAME=
TRACKJS_TOKEN=
APP_ENV=
REF_NAME=
REMOTE_CONFIG_URL=
DATADOG_SESSION_REPLAY_SAMPLE_RATE=
DATADOG_SESSION_SAMPLE_RATE=
DATADOG_APPLICATION_ID=
DATADOG_CLIENT_TOKEN=
RUDDERSTACK_KEY=
GROWTHBOOK_CLIENT_KEY=
GROWTHBOOK_DECRYPTION_KEY=
